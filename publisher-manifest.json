c;border-top:1px dashed rgba(56,30,12,.12);padding-top:10px;font-size:14.5px}\n.feature-list li:first-child{border-top:0;padding-top:0}\n.feature-list li::before{content:\"\";position:absolute;left:0;top:13px;width:8px;height:8px;border-radius:50%;background:#d6a16a}\n.feature-list li:first-child::before{top:3px}\n.plan.featured .feature-list li::before{background:#eaf7ef}\n\n/* 客户端 */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:8px}\n.client{background:#fff;border-radius:20px;padding:22px;box-shadow:0 16px 44px -28px rgba(56,30,12,.35)}\n.client h3{font-size:17px;display:flex;align-items:center;gap:10px}\n.client h3 .badge{font-size:11px;background:#dff3e6;color:#1f4d3a;padding:3px 8px;border-radius:999px;font-weight:500}\n.client p{font-size:14px;color:#4a3826;margin:8px 0 0}\n\n/* FAQ */\n.faq{display:flex;flex-direction:column;gap:12px;margin-top:8px}\ndetails{background:#fff;border-radius:18px;padding:0 22px;box-shadow:0 14px 40px -28px rgba(56,30,12,.3);transition:box-shadow .2s ease}\ndetails[open]{box-shadow:0 20px 50px -28px rgba(56,30,12,.4)}\nsummary{cursor:pointer;list-style:none;padding:18px 0;font-weight:600;color:#1a0f08;display:flex;justify-content:space-between;align-items:center;gap:18px;font-size:15.5px}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";font-size:22px;color:#1f4d3a;transition:transform .2s ease}\ndetails[open] summary::after{content:\"−\"}\n.faq-body{padding:4px 0 20px;color:#4a3826;font-size:14.5px}\n.faq-body p{margin:0 0 8px}\n.faq-body p:last-child{margin-bottom:0}\n\n/* 页脚 */\n.colophon{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;border-top:1px solid rgba(56,30,12,.1);padding-top:28px;margin-top:48px;color:#6e553a;font-size:13px}\n\n/* 响应式 */\n@media (max-width:860px){.hero-grid{grid-template-columns:1fr;gap:24px}\n  .duo,.clients{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;gap:14px}\n  .mosaic{grid-template-columns:repeat(2,1fr)}\n  section{padding:48px 0}\n  main{padding:0 20px 72px}}\n@media (max-width:480px){\n  .mosaic{grid-template-columns:1fr}\n  h1{margin-bottom:10px}\n  .plan{padding:22px}\n  .plan .tag{position:static;display:inline-block;margin-bottom:10px}\n}\n</style><main>\n\n<section class=\"hero\" id=\"top\">\n  <div class=\"hero-grid\">\n    <div class=\"col hero-left\">\n      <p class=\"eyebrow\">订阅服务 / 第 04 期</p>\n      <h1>机场(sbairport) · sbairport 机场</h1>\n      <p class=\"lead\">一份关于节点订阅、流量分配与多设备登录的目录。按照使用顺序展开：先看套餐，再看客户端，最后翻常见问题。</p>\n      <p class=\"standfirst\">本页面集中说明 sbairport 的订阅结构与设备配置流程，不涉及节点性能、线路速率或地区分布的承诺，具体节点详情以订阅链接解析后为准。</p>\n    </div>\n    <div class=\"col hero-right\">\n      <nav class=\"anchor-nav\" aria-label=\"页面内导航\">\n        <a class=\"chip active\" href=\"#plans\">套餐</a>\n        <a class=\"chip\" href=\"#clients\">客户端</a>\n        <a class=\"chip\" href=\"#guide\">使用说明</a>\n        <a class=\"chip\" href=\"#faq\">常见问题</a>\n        <a class=\"chip\" href=\"#colophon\">订阅须知</a>\n      </nav>\n      <blockquote class=\"pullquote\">\n        \"订阅是一次配置，三台设备并行。\"<br>\n        —— sbairport 编辑栏\n      </blockquote>\n      <div class=\"mosaic\">\n        <div class=\"tile\"><div class=\"num\">3</div><div class=\"lbl\">套餐档位</div></div>\n        <div class=\"tile\"><div class=\"num\">20</div><div class=\"lbl\">设备并发上限</div></div>\n        <div class=\"tile\"><div class=\"num\">1000G</div><div class=\"lbl\">团队版月流量</div></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <p class=\"eyebrow\">订阅档位</p>\n  <h2>三档套餐，逐级堆叠</h2>\n  <p>从个人试用、家庭多人到小团队协作，按流量配额与设备数依次展开。页面以单列大卡呈现，便于对比同一页内容。</p>\n\n  <div class=\"plans\">\n    <article class=\"plan\">\n      <div class=\"col\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <div class=\"plan-price\">¥15/月 <small>按年付仅需 ¥150/年</small></div>\n        </div>\n        <p class=\"plan-desc\">面向个人轻度使用，主要关注基础节点覆盖与单设备登录。</p>\n        <ul class=\"feature-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </div>\n      <div class=\"col\">\n        <p>适合日常浏览与单平台流媒体，节点池以普通线路为主。</p>\n      </div>\n    </article>\n\n    <article class=\"plan featured\">\n      <span class=\"tag\">推荐</span>\n      <div class=\"col\">\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <div class=\"plan-price\">¥35/月 <small>按年付仅需 ¥350/年</small></div>\n        </div>\n        <p class=\"plan-desc\">面向多设备家庭与对流媒体解锁有要求的用户，加入 IPLC 优化与优先支持。</p>\n        <ul class=\"feature-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </div>\n      <div class=\"col\">\n        <p>默认勾选年付较单月节省 ¥70。优先工单按提交顺序处理，常见问题可在下方 FAQ 提前查阅。</p>\n      </div>\n    </article>\n\n    <article class=\"plan\">\n      <div class=\"col\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <div class=\"plan-price\">¥85/月 <small>按年付仅需 ¥850/年</small></div>\n        </div>\n        <p class=\"plan-desc\">面向小型工作室与多成员协作，提供独立高带宽节点与定制路由。</p>\n        <ul class=\"feature-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </div>\n      <div class=\"col\">\n        <p>设备并发可拆分为多人共享，也可由团队统一管理后台；定制路由需提前与经理对齐使用场景。</p>\n      </div>\n    </article>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <p class=\"eyebrow\">客户端</p>\n  <h2>四类客户端，配置流程一致</h2>\n  <p>sbairport 订阅链接可直接填入以下客户端。配置仅涉及服务器地址与本地端口，不调整系统代理设置。</p>\n\n  <div class=\"clients\">\n    <article class=\"client\">\n      <h3>桌面端 · Clash <span class=\"badge\">macOS / Windows</span></h3>\n      <p>从用户中心复制订阅链接，粘贴至 Profiles → From URL，启用后即可看到节点组。本地端口默认 7890。</p>\n    </article>\n    <article class=\"client\">\n      <h3>桌面端 · v2rayN <span class=\"badge\">Windows</span></h3>\n      <p>在订阅分组中添加订阅地址，点击更新订阅后选择合适的节点右键设为活动服务器。</p>\n    </article>\n    <article class=\"client\">\n      <h3>移动端 · Shadowrocket <span class=\"badge\">iOS</span></h3>\n      <p>主页右上角添加订阅，粘贴链接并启用。允许添加 VPN 配置后回到首页切换节点。</p>\n    </article>\n    <article class=\"client\">\n      <h3>移动端 · Clash for Android <span class=\"badge\">Android</span></h3>\n      <p>配置 → 新建订阅 → 填入 URL → 保存并启用。设置页可调整系统代理模式为 Rule 或 Global。</p>\n    </article>\n  </div>\n</section>\n\n<section id=\"guide\">\n  <p class=\"eyebrow\">使用说明</p>\n  <h2>从购买到启用的四个步骤</h2>\n  <div class=\"duo\">\n    <div class=\"note\">\n      <h3>第一步 · 选择套餐</h3>\n      <ul>\n        <li>根据同时在线的设备数选择档位。</li>\n        <li>月付与年付均可，随时在用户中心切换。</li>\n        <li>套餐升级当月按差价补足。</li>\n      </ul>\n    </div>\n    <div class=\"note\">\n      <h3>第二步 · 取得订阅链接</h3>\n      <ul>\n        <li>付款完成后进入用户中心。</li>\n        <li>点击\"复制订阅 URL\"并妥善保存。</li>\n        <li>链接包含 token,请勿对外公开。</li>\n      </ul>\n    </div>\n    <div class=\"note\">\n      <h3>第三步 · 配置客户端</h3>\n      <ul>\n        <li>在任一支持订阅的客户端中添加 URL。</li>\n        <li>更新订阅后选择低延迟节点。</li>\n        <li>系统代理模式按需切换 Rule 或 Global。</li>\n      </ul>\n    </div>\n    <div class=\"note\">\n      <h3>第四步 · 日常维护</h3>\n      <ul>\n        <li>每月初重置流量额度,请留意用量提示。</li>\n        <li>客户端更新后建议重新拉取订阅。</li>\n        <li>遇到节点变动可在 FAQ 中查看处理方式。</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <p class=\"eyebrow\">常见问题</p>\n  <h2>订阅、流量与节点</h2>\n  <p>以下条目按订阅生命周期顺序排列,使用 details 折叠以便快速查阅。</p>\n\n  <div class=\"faq\">\n    <details>\n      <summary>订阅链接是否每次都会变化?</summary>\n      <div class=\"faq-body\">\n        <p>订阅 URL 在套餐有效期内保持不变。token 用于识别用户身份,请勿泄露至公共渠道。</p>\n        <p>若怀疑链接外泄,可在用户中心重置 token,旧链接即刻失效。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>流量如何计算?是否会重置?</summary>\n      <div class=\"faq-body\">\n        <p>流量按自然月重置,每月 1 日 00:00(UTC+8)重新计数,未使用部分不结转。</p>\n        <p>上行与下行均计入配额,本地代理至客户端之间的流量按实际字节数统计。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>套餐之间可以升降级吗?</summary>\n      <div class=\"faq-body\">\n        <p>支持随时升降级。升级时按剩余天数补足差价,降级则在下一计费周期生效。</p>\n        <p>同一计费周期内反复切换,差额会在用户中心的结算页显示明细。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>设备数超额登录会怎样?</summary>\n      <div class=\"faq-body\">\n        <p>超出套餐限制的新设备将被拒绝登录,已在使用的设备不受影响。</p>\n        <p>可在客户端设置中登出闲置设备,以腾出位置。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>节点列表为空该如何排查?</summary>\n      <div class=\"faq-body\">\n        <p>首先在客户端中手动更新订阅链接,确认网络可达订阅域名。</p>\n        <p>若节点仍为空,检查客户端时间是否准确,误差大于 90 秒会导致协议握手失败。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>套餐到期后订阅会保留多久?</summary>\n      <div class=\"faq-body\">\n        <p>套餐到期后订阅在 72 小时内仍可访问,期间续费可恢复全部配置。</p>\n        <p>超过 72 小时未续费,订阅链接与节点配置将被回收,重新购买后重新下发。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>支持哪些付款方式与发票?</summary>\n      <div class=\"faq-body\">\n        <p>用户中心提供常用在线支付方式,具体以付款页所示为准。</p>\n        <p>需要发票的订单请在付款前提交抬头信息,逾期不再补开。</p>\n      </div>\n    </details>\n  </div>\n</section>\n\n<footer id=\"colophon\" class=\"colophon\">\n  <div>\n    <strong>sbairport 机场</strong><br>\n    订阅说明页面 · 本页仅供已订购用户参考节点配置与套餐结构。\n  </div>\n  <div>\n    <a href=\"#top\">回到顶部</a> · <a href=\"#plans\">套餐</a> · <a href=\"#faq\">FAQ</a>\n  </div>\n</footer>\n\n</main>",
